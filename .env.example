# PARAVA-BACKEND Environment Configuration
PORT=5000
NODE_ENV=production

# Application URLs for CORS Whitelisting
APP_URL=https://parva.in
VENDOR_APP_URL=https://partner.parva.in
ADMIN_APP_URL=https://admin.parva.in

# Firebase Service Account Credentials (JSON string or file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=parva-prod-app

# Cashfree Payments Gateway Credentials
CASHFREE_ENV=PRODUCTION
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Resend Transactional Email API Key
RESEND_API_KEY=

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=