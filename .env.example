# ========================================================
# PARAVA-BACKEND Environment Configuration Example
# ========================================================
PORT=5000
NODE_ENV=development

# Application URLs for CORS Whitelisting
APP_URL=https://parava-frontend.onrender.com
VENDOR_APP_URL=https://parva-vendor-app.onrender.com
ADMIN_APP_URL=https://parva-admin.onrender.com

# Firebase Service Account Credentials (JSON string or file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=parva-prod-app

# Cashfree Payments Gateway Credentials
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ========================================================
# Resend Transactional Email API Key
# Sign up at https://resend.com and create an API Key
# ========================================================
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=PARVA Celebrations <onboarding@resend.dev>
SUPPORT_EMAIL=support@parvaevents.com

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=